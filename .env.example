# Active provider. Must match a key in ADAPTER_REGISTRY (openai | gemini | cloudflare).
MODEL_PROVIDER=cloudflare

# Cloudflare Workers AI — free tier, OpenAI-compatible endpoint. Default provider so the
# app runs without paid keys. Get both values from the Cloudflare dashboard (AI > Workers AI).
CLOUDFLARE_API_KEY=replace_with_your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=replace_with_your_cloudflare_account_id
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Optional — only needed if you set MODEL_PROVIDER=openai
# OPENAI_API_KEY=replace_with_your_openai_key
# OPENAI_MODEL=gpt-4o-mini

# Optional — only needed if you set MODEL_PROVIDER=gemini
# GEMINI_API_KEY=replace_with_your_gemini_key
# GEMINI_MODEL=gemini-2.0-flash

FRONTEND_ORIGIN=http://localhost:5173
CACHE_DB_PATH=cache.db
MODEL_MAX_RETRIES=2
ENABLE_TRACE=false
